# Browser-safe values only. Copy to .env.local for local Vite development.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Secrets belong in the server/deployment environment, never in VITE_*:
# SUPABASE_URL (optional server-only alias for VITE_SUPABASE_URL)
# SUPABASE_ANON_KEY (optional server-only alias for VITE_SUPABASE_ANON_KEY)
# OPENAI_API_KEY
# SUPABASE_SERVICE_ROLE_KEY
# OAUTH_STATE_SECRET
