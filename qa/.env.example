# ─── Nora QA Environment ─────────────────────────────────────
# Copy this file to qa/.env and fill in your values.
# NEVER commit qa/.env — it's in .gitignore.
# ─────────────────────────────────────────────────────────────

# URL of the running Nora instance (local or staging)
QA_BASE_URL=http://localhost:3000

# Supabase account credentials for automated testing
# Use a DEDICATED test account — not your real account
QA_EMAIL=qa-test@yourproject.com
QA_PASSWORD=your-test-password-here