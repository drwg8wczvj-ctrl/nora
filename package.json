{
  "name": "nora",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@supabase/supabase-js": "^2.106.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.14.0",
    "openai": "^6.35.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "stripe": "^22.3.0",
    "telegram": "^2.26.22",
    "web-vitals": "^2.1.4",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:budget": "node scripts/check-build-budget.mjs",
    "audit:styles": "node scripts/audit-style-architecture.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src api --ext .js,.ts,.tsx",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run build && npm run build:budget",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.generated.ts",
    "qa": "playwright test --config=qa/playwright.config.js",
    "qa:desktop": "playwright test --config=qa/playwright.config.js --project=desktop",
    "qa:mobile": "playwright test --config=qa/playwright.config.js --project=mobile",
    "qa:report": "playwright show-report qa/playwright-report",
    "qa:setup": "playwright test --config=qa/playwright.config.js --project=setup"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vitest-globals": "^1.6.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
